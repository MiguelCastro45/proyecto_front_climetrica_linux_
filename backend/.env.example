# ============================================================
# Configuración del BACKEND (Django) — Climétrica
# Copia este archivo a  backend/.env  y rellena los valores.
# NUNCA subas el archivo .env real al repositorio.
# ============================================================

# --- Base de datos MongoDB ---
# Local:      mongodb://localhost:27017/climetricadb
# Atlas/prod: mongodb+srv://usuario:password@cluster.mongodb.net/climetricadb
MONGO_URI=mongodb://localhost:27017/climetricadb

# --- Autenticación JWT ---
# Genera un valor aleatorio, p.ej.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIA_ESTO_por_un_valor_aleatorio_largo
JWT_ALGORITHM=HS256
JWT_EXP_DAYS=7

# --- Cifrado de credenciales en login (AES, compatible con CryptoJS del frontend) ---
# DEBE ser EXACTAMENTE el mismo valor que REACT_APP_ENCRYPTION_KEY en frontend/.env
ENCRYPTION_KEY=CAMBIA_ESTO_mismo_valor_que_el_frontend

# --- Django ---
# Genera con:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CAMBIA_ESTO_secret_key_de_django
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (orígenes del frontend permitidos) ---
# En desarrollo puede quedarse en True. En producción: False + lista de orígenes.
DJANGO_CORS_ALLOW_ALL=True
DJANGO_CORS_ORIGINS=http://localhost:3000

# --- Envío de correo (recuperación de contraseña) — opcional ---
# Ver backend/CONFIGURACION_CORREO.md
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=clave_de_aplicacion_de_gmail
