# ============================================================
# Configuración del FRONTEND (Create React App) — Climétrica
# Copia este archivo a  frontend/.env  y rellena los valores.
# Nota: en una app de React TODAS las variables REACT_APP_* quedan
# incrustadas en el bundle público. No pongas aquí secretos reales
# de servidor; sólo claves de APIs públicas de cliente.
# ============================================================

# Clave AES para cifrar email/contraseña en el login.
# DEBE ser EXACTAMENTE igual a ENCRYPTION_KEY en backend/.env
REACT_APP_ENCRYPTION_KEY=CAMBIA_ESTO_mismo_valor_que_el_backend

# API key de OpenWeatherMap (capas de temperatura/viento del mapa)
# Obtener gratis en https://openweathermap.org/api
REACT_APP_OWM_KEY=

# API key de Groq (análisis de cultivos con IA) — opcional
# Obtener gratis en https://console.groq.com/keys
REACT_APP_GROQ_API_KEY=
